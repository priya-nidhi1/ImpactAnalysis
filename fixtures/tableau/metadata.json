{
  "datasources": [
    {
      "name": "Policy Analytics",
      "fields": [
        {"name": "Policy Status", "upstreamColumns": [{"table": "insurance.policy.policies", "name": "policy_status"}]},
        {"name": "Premium Amount", "upstreamColumns": [{"table": "insurance.policy.policies", "name": "premium_amount"}]},
        {"name": "Policy Id", "upstreamColumns": [{"table": "insurance.policy.policies", "name": "policy_id"}]},
        {"name": "Effective Date", "upstreamColumns": [{"table": "insurance.policy.policies", "name": "effective_date"}]},
        {"name": "Expiry Date", "upstreamColumns": [{"table": "insurance.policy.policies", "name": "expiry_date"}]},
        {"name": "Product Code", "upstreamColumns": [{"table": "insurance.policy.policies", "name": "product_code"}]}
      ],
      "calculatedFields": [
        {"name": "Active Flag", "formula": "IF [Policy Status] = \"ACTIVE\" THEN 1 ELSE 0 END"},
        {"name": "Status Label", "formula": "UPPER([Policy Status])"},
        {"name": "Days To Expiry", "formula": "DATEDIFF('day', TODAY(), [Expiry Date])"}
      ]
    },
    {
      "name": "Claims Analytics",
      "fields": [
        {"name": "Claim Id", "upstreamColumns": [{"table": "insurance.policy.claims", "name": "claim_id"}]},
        {"name": "Claim Amount", "upstreamColumns": [{"table": "insurance.policy.claims", "name": "claim_amount"}]},
        {"name": "Claim Status", "upstreamColumns": [{"table": "insurance.policy.claims", "name": "claim_status"}]},
        {"name": "Loss Type", "upstreamColumns": [{"table": "insurance.policy.claims", "name": "loss_type"}]},
        {"name": "Claim Date", "upstreamColumns": [{"table": "insurance.policy.claims", "name": "claim_date"}]}
      ],
      "calculatedFields": [
        {"name": "Large Claim Flag", "formula": "IF [Claim Amount] > 50000 THEN 1 ELSE 0 END"},
        {"name": "Loss Category", "formula": "IF [Loss Type] = \"FIRE\" THEN \"Property\" ELSE \"Other\" END"}
      ]
    },
    {
      "name": "Payments Analytics",
      "fields": [
        {"name": "Payment Amount", "upstreamColumns": [{"table": "insurance.policy.payments", "name": "payment_amount"}]},
        {"name": "Payment Method", "upstreamColumns": [{"table": "insurance.policy.payments", "name": "payment_method"}]},
        {"name": "Payment Status", "upstreamColumns": [{"table": "insurance.policy.payments", "name": "payment_status"}]},
        {"name": "Payment Date", "upstreamColumns": [{"table": "insurance.policy.payments", "name": "payment_date"}]}
      ],
      "calculatedFields": [
        {"name": "Collected Flag", "formula": "IF [Payment Status] = \"SETTLED\" THEN 1 ELSE 0 END"}
      ]
    },
    {
      "name": "Distribution Analytics",
      "fields": [
        {"name": "Agent Name", "upstreamColumns": [{"table": "insurance.policy.agents", "name": "agent_name"}]},
        {"name": "Region", "upstreamColumns": [{"table": "insurance.policy.agents", "name": "region"}]},
        {"name": "Channel", "upstreamColumns": [{"table": "insurance.policy.agents", "name": "channel"}]}
      ],
      "calculatedFields": [
        {"name": "Region Group", "formula": "IF [Region] = \"NORTH\" THEN \"Northern\" ELSE \"Southern\" END"}
      ]
    }
  ],
  "workbooks": [
    {
      "name": "Policy Reporting",
      "worksheets": [
        {"name": "Status Breakdown", "datasource": "Policy Analytics", "fields": ["Policy Status", "Active Flag"]},
        {"name": "Premium Trend", "datasource": "Policy Analytics", "fields": ["Premium Amount", "Effective Date"]},
        {"name": "Renewal Pipeline", "datasource": "Policy Analytics", "fields": ["Expiry Date", "Days To Expiry", "Policy Status"]}
      ],
      "dashboards": [
        {"name": "Executive Policy Dashboard", "worksheets": ["Status Breakdown", "Premium Trend", "Renewal Pipeline"]}
      ]
    },
    {
      "name": "Claims Reporting",
      "worksheets": [
        {"name": "Claims Volume", "datasource": "Claims Analytics", "fields": ["Claim Id", "Claim Amount", "Claim Status"]},
        {"name": "Loss Type Mix", "datasource": "Claims Analytics", "fields": ["Loss Type", "Loss Category"]},
        {"name": "Large Claims", "datasource": "Claims Analytics", "fields": ["Claim Amount", "Large Claim Flag"]}
      ],
      "dashboards": [
        {"name": "Claims Overview", "worksheets": ["Claims Volume", "Loss Type Mix"]},
        {"name": "Claims Risk Review", "worksheets": ["Large Claims", "Loss Type Mix"]}
      ]
    },
    {
      "name": "Finance Reporting",
      "worksheets": [
        {"name": "Collections", "datasource": "Payments Analytics", "fields": ["Payment Amount", "Payment Status", "Collected Flag"]},
        {"name": "Payment Mix", "datasource": "Payments Analytics", "fields": ["Payment Method"]}
      ],
      "dashboards": [
        {"name": "Finance Collections Dashboard", "worksheets": ["Collections", "Payment Mix"]}
      ]
    },
    {
      "name": "Distribution Reporting",
      "worksheets": [
        {"name": "Agent Leaderboard", "datasource": "Distribution Analytics", "fields": ["Agent Name", "Region"]},
        {"name": "Channel Mix", "datasource": "Distribution Analytics", "fields": ["Channel", "Region Group"]}
      ],
      "dashboards": [
        {"name": "Distribution Performance", "worksheets": ["Agent Leaderboard", "Channel Mix"]}
      ]
    }
  ]
}
